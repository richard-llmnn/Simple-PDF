{
  "name": "Simple-PDF",
  "version": "1.1.7",
  "main": "dist/index.html",
  "repository": "git@github.com:richard-llmnn/Simple-PDF.git",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "@shopify/draggable": "^1.1.4",
    "bootstrap": "^5.3.3",
    "css.gg": "=2.1.1",
    "dropzone": "^6.0.0-beta.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.0.375"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "build:dev": "bun build src/app.html --entry-naming=index.html --chunk-naming=\"index.[ext]\" --outdir=dist",
    "build:prod": "bun build src/app.html --entry-naming=index.html --chunk-naming=\"index.[ext]\" --outdir=dist --production",
    "serve": "bun src/app.html",
    "format": "prettier --print-width=120  --tab-width=4 --write src/",
    "deploy": "rm -rf dist && bun run build:prod && gh-pages --message \"Deploy version $npm_package_version\" --dist dist"
  }
}